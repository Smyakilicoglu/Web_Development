<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Name Letters</title>
</head>

<body>
  <!-- Write your code here -->
  <!--Locals. tanımlı olmalı yoksa kod çalışmaz dorumu algılamaz nerede olduğunu 
  numberOfLetters is not defined bu sonuca ulaşır yazdığımız değerin var olup olmadığını bulmak için 
  js dosyalarına bakar o olmadan çalışmaz-->
  <% if (locals.numberOfLetters) { %>
    <h1>There are <%= numberOfLetters %> letters in your name.</h1>
    <% } else { %>
      <h1>Enter your name below 👇</h1>
      <% } %>
        <form action="/submit" method="POST">
          <input type="text" name="fName" placeholder="First name">
          <input type="text" name="lName" placeholder="Last name">
          <input type="submit" value="OK">
        </form>
</body>

</html>